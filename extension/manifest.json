{
  "manifest_version": 3,
  "name": "NOVUM ChatGPT PC Bridge",
  "version": "0.1.0",
  "description": "Connect ChatGPT Web to a local Windows PC bridge.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "NOVUM PC Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
